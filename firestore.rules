rules_version = '2';
service cloud.firestore {
   match /databases/{database}/documents {
     // Allow authenticated users to read/write their own profile
     match /users/{userId} {
       allow read, write: if request.auth != null && request.auth.uid == userId;
     }
     // Businesses: anyone can read, authenticated users can create/manage their own
     match /businesses/{businessId} {
       allow read: if true;
       allow create: if request.auth != null;
       // Owner can update anything; any authenticated user can update review stats
       allow update: if request.auth != null
                     && (resource.data.ownerId == request.auth.uid
                         || resource.data.ownerId == 'seed'
                         || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'reviewCount']));
       allow delete: if request.auth != null
                     && (resource.data.ownerId == request.auth.uid || resource.data.ownerId == 'seed');
     }

     // Reviews: anyone can read, authenticated users can create/update
     match /reviews/{reviewId} {
       allow read: if true;
       allow create: if request.auth != null;
       allow update: if request.auth != null;
     }

     // Immigration guides: anyone can read; create allowed for seeding
     match /immigrationGuides/{guideId} {
       allow read: if true;
       allow create: if request.auth != null;
     }

     // Lawyers: anyone can read; authenticated users can register; owners can update/delete
     match /lawyers/{lawyerId} {
       allow read: if true;
       allow create: if request.auth != null;
       allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
       allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
     }
   }
}
