rules_version = '2';
service cloud.firestore {
   match /databases/{database}/documents {
     // Allow authenticated users to read/write their own profile
     match /users/{userId} {
       allow read, write: if request.auth != null && request.auth.uid == userId;
     }
     // Allow authenticated users to read all businesses, write their own
     match /businesses/{businessId} {
       allow read: if request.auth != null;
       allow create: if request.auth != null;
       allow update: if request.auth != null
                     && (resource.data.ownerId == request.auth.uid || resource.data.ownerId == 'seed');
       allow delete: if request.auth != null
                     && (resource.data.ownerId == request.auth.uid || resource.data.ownerId == 'seed');
     }

     // Reviews: anyone authenticated can read, create; owner of the business can respond
     match /reviews/{reviewId} {
       allow read: if request.auth != null;
       allow create: if request.auth != null;
       allow update: if request.auth != null;
     }

     // Immigration guides: authenticated users can read; create allowed for seeding
     match /immigrationGuides/{guideId} {
       allow read: if request.auth != null;
       allow create: if request.auth != null;
     }

     // Lawyers: authenticated users can read; create allowed for seeding
     match /lawyers/{lawyerId} {
       allow read: if request.auth != null;
       allow create: if request.auth != null;
     }
   }
}