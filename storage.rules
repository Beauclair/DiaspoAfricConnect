rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ── Public reads for all images ────────────────────────────────────
    match /{allPaths=**} {
      allow read: if true;
    }

    // ── Business photos ────────────────────────────────────────────────
    // Path: /businesses/{uid}/{businessId}/{fileName}
    // Only the owning user can write into their own UID folder.
    match /businesses/{uid}/{businessId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024        // 10 MB
                   && request.resource.contentType.matches('image/.*'); // images only
    }

    // ── Attorney profile photos ───────────────────────────────────────
    // Path: /lawyers/{uid}/{lawyerId}/{fileName}
    match /lawyers/{uid}/{lawyerId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024        // 10 MB
                   && request.resource.contentType.matches('image/.*'); // images only
    }
  }
}
